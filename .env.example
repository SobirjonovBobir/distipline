# Required on Vercel / any hosted deploy (phone sync).
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Neon (or Supabase) Postgres connection string — pooled is fine for the app.
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: Neon direct (non-pooled) URL — preferred for migrations during `npm run build`.
# If unset, migrate.mjs falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
